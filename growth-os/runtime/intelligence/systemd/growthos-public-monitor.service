[Unit]
Description=Growth OS public site monitor
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=oneshot
User=amirreza
Group=amirreza
ExecStart=/bin/bash /opt/growth-os/repo/growth-os/runtime/intelligence/run_public_monitor.sh
Nice=10

[Install]
WantedBy=multi-user.target
